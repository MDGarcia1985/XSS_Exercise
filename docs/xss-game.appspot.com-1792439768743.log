(() => {
  const events = ["click", "input", "change", "submit",
                  "focus", "keydown", "error"];

  const log = (type, details) => {
    console.log("[XSS TRACE]", {
      time: new Date().toISOString(),
      type,
      ...details
    });
  };

  events.forEach(type => {
    document.addEventListener(type, event => {
      log(type, {
        tag: event.target?.tagName,
        id: event.target?.id,
        value: event.target?.value,
        key: event.key,
        url: location.href
      });
    }, true);
  });

  window.addEventListener("message", event => {
    log("postMessage", {
      origin: event.origin,
      data: event.data,
      source: event.source === window.parent
        ? "parent"
        : "other"
    });
  });

  window.addEventListener("hashchange", () => {
    log("hashchange", {
      hash: location.hash
    });
  });

  window.addEventListener("popstate", () => {
    log("popstate", {
      url: location.href
    });
  });

  log("LOGGER STARTED", {
    url: location.href
  });
})();
